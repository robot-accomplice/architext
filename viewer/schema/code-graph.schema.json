{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architext.local/schema/code-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "generator", "language", "module", "sha",
    "tree", "fidelity", "computable"
  ],
  "properties": {
    "contract_version": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "module": { "type": "string" },
    "sha": { "type": "string" },
    "tree": { "type": "string", "enum": ["clean", "dirty"] },
    "fidelity": { "type": "string" },
    "computable": { "type": "boolean" },
    "not_computable_reason": { "type": "string" },
    "functions": { "type": ["array", "null"], "items": { "$ref": "#/$defs/function" } },
    "calls": { "type": ["array", "null"], "items": { "$ref": "#/$defs/call" } },
    "modules": { "type": ["array", "null"], "items": { "$ref": "#/$defs/module" } },
    "module_calls": { "type": ["array", "null"], "items": { "$ref": "#/$defs/moduleCall" } }
  },
  "allOf": [
    {
      "if": { "properties": { "computable": { "const": false } } },
      "then": {
        "required": ["not_computable_reason"],
        "properties": {
          "functions": { "type": "null" },
          "calls": { "type": "null" },
          "modules": { "type": "null" },
          "module_calls": { "type": "null" }
        }
      },
      "else": {
        "required": ["functions", "calls", "modules", "module_calls"],
        "properties": {
          "functions": { "type": "array" },
          "calls": { "type": "array" },
          "modules": { "type": "array" },
          "module_calls": { "type": "array" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "results"],
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "symbol", "pkg", "file", "line", "kind", "exported", "test",
        "root", "generated", "reachable", "prod_reachable", "signature",
        "fan_in", "fan_out"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "symbol": { "type": "string", "minLength": 1 },
        "pkg": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "kind": { "type": "string", "enum": ["func", "method"] },
        "exported": { "type": "boolean" },
        "test": { "type": "boolean" },
        "root": { "type": "boolean" },
        "generated": { "type": "boolean" },
        "reachable": { "type": "boolean" },
        "prod_reachable": { "type": "boolean" },
        "signature": { "$ref": "#/$defs/signature" },
        "doc": { "type": "string" },
        "fan_in": { "type": "integer" },
        "fan_out": { "type": "integer" }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "site_file", "site_line", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "site_file": { "type": "string" },
        "site_line": { "type": "integer" },
        "kind": { "type": "string", "enum": ["static", "dynamic"] }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pkg", "function_ids", "counts", "fan_in", "fan_out"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pkg": { "type": "string" },
        "function_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functions", "dead", "test_only"],
          "properties": {
            "functions": { "type": "integer" },
            "dead": { "type": "integer" },
            "test_only": { "type": "integer" }
          }
        },
        "fan_in": { "type": "integer" },
        "fan_out": { "type": "integer" }
      }
    },
    "moduleCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "count", "has_dynamic"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "count": { "type": "integer" },
        "has_dynamic": { "type": "boolean" }
      }
    }
  }
}
